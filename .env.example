# ================================================================
# Sage AI — .env テンプレート（このファイルをコピーして使用）
#
# cp .env.example .env
# python setup.py   ← 対話形式でまとめて設定できます
#
# ⚠️ .env は絶対にGitにコミットしないでください
# ================================================================

# ── Flaskサーバー ──────────────────────────────────────────────
FLASK_APP=backend/flask_server.py
FLASK_PORT=8080
FLASK_DEBUG=0
PYTHONPATH=.

# ── AI APIキー（最低1つ必須） ──────────────────────────────────
# Groq: https://console.groq.com/ → API Keys → Create API Key
GROQ_API_KEY=

# Perplexity（リサーチ機能用・任意）: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Google Gemini（任意）: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ── Notion連携 ────────────────────────────────────────────────
# https://www.notion.so/my-integrations → New integration
NOTION_API_KEY=
# コンテンツプールのデータベースID（URLの末尾32文字）
NOTION_CONTENT_POOL_DB_ID=
# エビデンスレジャーのデータベースID（任意）
NOTION_EVIDENCE_LEDGER_DB_ID=
NOTION_EVIDENCE_DB_ID=
NOTION_RUNBOOK_PARENT_PAGE_ID=
# Notion連携を有効にする（1=有効, 0=無効）
SAGE_ENABLE_NOTION=1

# ── Bluesky（SNS自動投稿） ────────────────────────────────────
# Bluesky Settings → App Passwords → Add App Password
# ※ メインパスワードではなくApp Passwordを使用すること
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=
# Bluesky投稿を有効にする（1=有効, 0=無効）
SAGE_ENABLE_BLUESKY=1

# ── Twitter/X（任意） ─────────────────────────────────────────
# https://developer.twitter.com/ → Your Project → Keys and Tokens
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_BEARER_TOKEN=

# ── Instagram（任意・Businessアカウント + Facebook連携必須） ──
# Graph API: https://developers.facebook.com/
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_APP_ID=

# ── Telegram通知（推奨） ──────────────────────────────────────
# 1. @BotFather → /newbot → Token取得
# 2. @userinfobot でChat ID確認
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram通知を有効にする（1=有効, 0=無効）
SAGE_ENABLE_TELEGRAM=1

# ── Make.com Webhook ──────────────────────────────────────────
# ウェルカムメール等の自動化シナリオのWebhook URL
MAKE_WEBHOOK_URL=

# ── Gumroad ───────────────────────────────────────────────────
# https://app.gumroad.com/settings/advanced → Access Token
GUMROAD_APP_ID=
GUMROAD_APP_SECRET=
GUMROAD_ACCESS_TOKEN=

# ── Cloudflare ────────────────────────────────────────────────
# Profile → API Tokens → Create Token
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_PAGES_PROJECT_NAME=sage-ai
# Cloudflare API Token（D1操作用・CF_API_TOKENと同じでOK）
CLOUDFLARE_API_TOKEN=

# ── ngrok（ローカルサーバーの外部公開） ──────────────────────
# https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# ── Firebase（任意・ブログHP用） ──────────────────────────────
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Firebase Admin SDK サービスアカウントJSON（1行に圧縮して貼り付け）
FIREBASE_SERVICE_ACCOUNT_KEY=

# ── Hugging Face（画像生成・任意） ────────────────────────────
HF_TOKEN=

# ── Whop（メンバーシップ販売・任意） ─────────────────────────
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_DRY_RUN=1

# ── Sage動作フラグ ────────────────────────────────────────────
# モックモード（実際にAPI呼び出しをしない）
SAGE_MOCK_MODE=0
# セーフモード（破壊的操作を防ぐ）
SAGE_SAFE_MODE=0
# 投稿のドライラン（実際には投稿しない）
SAGE_POST_DRY_RUN=0
# セルフヒーリング（自己修復機能）
SAGE_ENABLE_SELF_HEALING=1
# 自律実行モード（0=手動のみ）
SAGE_AUTONOMOUS_ENABLED=0
# セルフテスト
SAGE_ENABLE_SELF_TEST=1
# 管理者トークン（setup.pyで自動生成）
SAGE_ADMIN_TOKEN=
# ベースURL
SAGE_BASE_URL=http://localhost:8080
# バックエンドURL（フロントエンドから参照）
VITE_BACKEND_URL=http://localhost:8080

# ── セキュリティ ──────────────────────────────────────────────
SAGE_SECURITY_LEDGER_ENABLED=1
# セキュリティVaultキー（setup.pyで自動生成）
SAGE_VAULT_KEY=

# ── Payment / Sales Page URLs ─────────────────────────────────
# Used in backend email templates and frontend sales pages
GUMROAD_PRODUCT_URL=
GUMROAD_FALLBACK_URL=
PAYPAL_ME_URL=
SITE_URL=https://your-site.pages.dev

# ── Frontend-specific (VITE_* vars) ──────────────────────────
# These are used in frontend/src/pages/ — also set in frontend/.env
VITE_SUPPORT_EMAIL=support@your-domain.com
VITE_WHOP_URL=https://whop.com/your-product/
VITE_GUMROAD_URL=https://yourusername.gumroad.com/l/your-product
VITE_PAYPAL_URL=https://paypal.me/yourusername/20
VITE_STRIPE_PRO_URL=https://buy.stripe.com/your-stripe-link
VITE_STRIPE_ENT_URL=https://buy.stripe.com/your-enterprise-link
VITE_BACKEND_URL=http://localhost:8080
