# ─────────────────────────────────────────────────────────────────────────────
# Sage AI — Frontend Environment Variables
# Copy this file to frontend/.env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Firebase (optional — for blog/auth) ──────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ── Backend URL ───────────────────────────────────────────────────────────────
VITE_BACKEND_URL=http://localhost:8080

# ── Support Contact ───────────────────────────────────────────────────────────
VITE_SUPPORT_EMAIL=support@your-domain.com

# ── Payment / Sales Links ─────────────────────────────────────────────────────
VITE_WHOP_URL=https://whop.com/your-product/
VITE_GUMROAD_URL=https://yourusername.gumroad.com/l/your-product
VITE_PAYPAL_URL=https://paypal.me/yourusername/20
VITE_STRIPE_PRO_URL=https://buy.stripe.com/your-pro-link
VITE_STRIPE_ENT_URL=https://buy.stripe.com/your-enterprise-link
