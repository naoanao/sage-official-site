        "hook": 2268260,
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": { "x": 0, "y": 0 },
        "restore": {
          "parameters": {
            "hook": {
              "label": "Sage Stripe Webhook",
              "data": {
                "editable": true,
                "types": ["text"]
              }
            }
          }
        },
        "parameters": [
